# Origin only (no path). Empty in production so API calls are same-origin (/api) through
# the Cloudflare proxy. For local dev, override in a gitignored .env with http://localhost:3001.
SERVER_URL=

# Public Google OAuth client id. Real value is injected by Cloudflare Pages in production
# (set by Terraform) and from a local .env in dev. Must match the server's GOOGLE_CLIENT_ID.
REACT_APP_GOOGLE_CLIENT_ID=
